    "eslint-plugin-solid": "^0.18.0",
    "eslint-plugin-svelte": "^3.22.0",
    "eslint-plugin-vue": "^10.12.0",
    "next": "^16.3.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
