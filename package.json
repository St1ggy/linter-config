  "types": "./index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./eslint-next": {
      "types": "./index.d.ts",
      "import": "./src/eslint/eslint.config.next.js",
      "default": "./src/eslint/eslint.config.next.js"
    },
    "./eslint-react": {
      "types": "./index.d.ts",
      "import": "./src/eslint/eslint.config.react.js",
      "default": "./src/eslint/eslint.config.react.js"
    },
    "./eslint-solid": {
      "types": "./index.d.ts",
      "import": "./src/eslint/eslint.config.solid.js",
      "default": "./src/eslint/eslint.config.solid.js"
    },
    "./eslint-svelte": {
      "types": "./index.d.ts",
      "import": "./src/eslint/eslint-svelte.config.js",
      "default": "./src/eslint/eslint-svelte.config.js"
    },
    "./eslint-astro": {
      "types": "./index.d.ts",
      "import": "./src/eslint/eslint.config.astro.js",
      "default": "./src/eslint/eslint.config.astro.js"
    },
    "./eslint-common": {
      "types": "./index.d.ts",
      "import": "./src/eslint/eslint.config.common.js",
      "default": "./src/eslint/eslint.config.common.js"
    },
    "./common-ox": {
      "types": "./src/oxlint/index.d.ts",
      "import": "./src/oxlint/oxlint.config.common.js",
      "default": "./src/oxlint/oxlint.config.common.js"
    },
    "./react-ox": {
      "types": "./src/oxlint/index.d.ts",
      "import": "./src/oxlint/oxlint.config.react.js",
      "default": "./src/oxlint/oxlint.config.react.js"
    },
    "./solid-ox": {
      "types": "./src/oxlint/index.d.ts",
      "import": "./src/oxlint/oxlint.config.solid.js",
      "default": "./src/oxlint/oxlint.config.solid.js"
    },
    "./next-ox": {
      "types": "./src/oxlint/index.d.ts",
      "import": "./src/oxlint/oxlint.config.next.js",
      "default": "./src/oxlint/oxlint.config.next.js"
    },
    "./svelte-ox": {
