      "default": "./src/oxfmt/oxfmt.config.common.js"
    },
    "./oxfmt-svelte": {
      "types": "./src/oxfmt/index.d.ts",
      "import": "./src/oxfmt/oxfmt.config.svelte.js",
      "default": "./src/oxfmt/oxfmt.config.svelte.js"
    },
    "./oxfmt-astro": {
      "types": "./src/oxfmt/index.d.ts",
      "import": "./src/oxfmt/oxfmt.config.astro.js",
      "default": "./src/oxfmt/oxfmt.config.astro.js"
    },
    "./oxfmt-angular": {
      "types": "./src/oxfmt/index.d.ts",
      "import": "./src/oxfmt/oxfmt.config.angular.js",
      "default": "./src/oxfmt/oxfmt.config.angular.js"
    },
    "./prettier-svelte": {
      "types": "./index.d.ts",
      "import": "./src/prettier/prettier-svelte.config.js",
      "default": "./src/prettier/prettier-svelte.config.js"
    },
    "./prettier-astro": {
      "types": "./index.d.ts",
      "import": "./src/prettier/prettier-astro.config.js",
      "default": "./src/prettier/prettier-astro.config.js"
    },
    "./stylelint-scss": {
      "types": "./index.d.ts",
      "import": "./src/stylelint/stylelint.config.scss.js",
      "default": "./src/stylelint/stylelint.config.scss.js"
    }
  },
  "files": [
    "index.d.ts",
    "src",
    "scripts",
    "data",
    "docs",
    "!scripts/fixtures",
    "!scripts/*.test.mjs",
    "!scripts/oxlint-*.mjs",
    "!scripts/oxfmt-*.mjs",
    "!scripts/package-smoke.mjs"
  ],
  "scripts": {
    "lint": "eslint . && stylelint \"src/**/*.{css,scss}\" --config ./src/stylelint/stylelint.config.scss.js --allow-empty-input && prettier --check .",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.{css,scss}\" --config ./src/stylelint/stylelint.config.scss.js --allow-empty-input",
    "lint:prettier": "prettier --check .",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,scss}\" --config ./src/stylelint/stylelint.config.scss.js --fix --allow-empty-input && prettier --write .",
    "lint:fix:eslint": "npm run lint:fix",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "changelog:dry": "conventional-changelog -p conventionalcommits",
    "publish:npm": "npm publish --access public",
    "inventory": "node ./scripts/inventory.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "generate:ox": "node scripts/oxlint-generate.mjs",
    "generate:ox:check": "node scripts/oxlint-generate.mjs --check",
    "inventory:ox": "node scripts/oxlint-inventory.mjs --write",
    "inventory:ox:check": "node scripts/oxlint-inventory.mjs --source-only --check && node scripts/oxlint-inventory.mjs --check",
    "test:ox": "node --test --test-concurrency=2 scripts/oxlint-*.test.mjs",
    "format:ox:compare": "node scripts/oxfmt-compare.mjs",
    "format:ox:check": "oxfmt --config ./src/oxfmt/oxfmt.config.common.js --check .",
    "config:init": "node ./scripts/linter-init.mjs init --common --dir ./examples/init-smoke",
    "config:migrate": "node ./scripts/linter-init.mjs migrate --common --dir ./examples/init-smoke",
    "config:reinit": "node ./scripts/linter-init.mjs reinit --common --dir ./examples/init-smoke",
    "config:create": "node ./scripts/linter-init.mjs create --common --dir ./examples/init-smoke",
    "config:remove-current": "bash ./scripts/remove-current.sh"
  },
  "peerDependencies": {
    "@angular-eslint/eslint-plugin": "^22.6.0",
