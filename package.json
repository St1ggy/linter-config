      "default": "./src/oxlint/oxlint.config.svelte.js"
    },
    "./astro-ox": {
      "types": "./src/oxlint/index.d.ts",
      "import": "./src/oxlint/oxlint.config.astro.js",
      "default": "./src/oxlint/oxlint.config.astro.js"
    },
    "./angular-ox": {
      "types": "./src/oxlint/index.d.ts",
      "import": "./src/oxlint/oxlint.config.angular.js",
      "default": "./src/oxlint/oxlint.config.angular.js"
    },
    "./vue-ox": {
      "types": "./src/oxlint/index.d.ts",
      "import": "./src/oxlint/oxlint.config.vue.js",
      "default": "./src/oxlint/oxlint.config.vue.js"
    },
    "./nuxt-ox": {
      "types": "./src/oxlint/index.d.ts",
      "import": "./src/oxlint/oxlint.config.nuxt.js",
      "default": "./src/oxlint/oxlint.config.nuxt.js"
    },
    "./eslint-svelte-ox": {
      "types": "./src/eslint/ox-supplement.d.ts",
      "import": "./src/eslint/eslint.config.svelte-ox.js",
      "default": "./src/eslint/eslint.config.svelte-ox.js"
    },
    "./eslint-astro-ox": {
      "types": "./src/eslint/ox-supplement.d.ts",
      "import": "./src/eslint/eslint.config.astro-ox.js",
      "default": "./src/eslint/eslint.config.astro-ox.js"
    },
    "./eslint-angular-ox": {
      "types": "./src/eslint/ox-supplement.d.ts",
      "import": "./src/eslint/eslint.config.angular-ox.js",
      "default": "./src/eslint/eslint.config.angular-ox.js"
    },
    "./eslint-vue-ox": {
      "types": "./src/eslint/ox-supplement.d.ts",
      "import": "./src/eslint/eslint.config.vue-ox.js",
      "default": "./src/eslint/eslint.config.vue-ox.js"
